{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agiledefense.example/schemas/mig/1.0",
  "title": "Mission Intent Graph (MIG) v1.0",
  "description": "Canonical mission representation produced by the LLM decomposer and validated by the deterministic constraint checker before human authorization.",
  "type": "object",
  "required": ["version", "mission_id", "created_at", "intent", "vehicles", "waypoints", "constraints", "status"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "mission_id": {
      "type": "string",
      "pattern": "^MSN-[0-9A-F]{8}$",
      "description": "Unique mission identifier (e.g. MSN-A1B2C3D4)"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC creation timestamp (ISO 8601)"
    },
    "intent": {
      "type": "string",
      "minLength": 10,
      "description": "Original natural-language mission intent"
    },
    "vehicles": {
      "type": "array",
      "items": { "$ref": "#/definitions/Vehicle" }
    },
    "waypoints": {
      "type": "array",
      "items": { "$ref": "#/definitions/Waypoint" }
    },
    "constraints": { "$ref": "#/definitions/Constraints" },
    "status": {
      "type": "string",
      "enum": ["planning", "validation_failed", "pending_authorization", "authorized", "dispatching", "dispatched", "failed"]
    },
    "validation_errors": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "definitions": {
    "Vehicle": {
      "type": "object",
      "required": ["id", "vehicle_type", "sitl_target", "mavlink_sysid", "waypoints"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "vehicle_type": { "type": "string", "enum": ["multirotor", "rover"] },
        "sitl_target": { "type": "string" },
        "mavlink_sysid": { "type": "integer", "minimum": 1, "maximum": 255 },
        "waypoints": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Ordered list of Waypoint IDs assigned to this vehicle"
        }
      }
    },
    "Waypoint": {
      "type": "object",
      "required": ["id", "lat", "lon", "alt_m", "role"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "alt_m": { "type": "number", "minimum": -100 },
        "role": {
          "type": "string",
          "description": "Semantic role: survey | loiter | perimeter | rtl | transit | etc."
        }
      }
    },
    "Constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "geofence_polygon": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          },
          "description": "List of [lat, lon] pairs forming the geofence boundary"
        },
        "max_alt_m": { "type": "number", "default": 120.0 },
        "min_alt_m": { "type": "number", "default": 2.0 },
        "require_rtl": { "type": "boolean", "default": true },
        "max_range_m": { "type": "number", "default": 5000.0 }
      }
    }
  }
}
