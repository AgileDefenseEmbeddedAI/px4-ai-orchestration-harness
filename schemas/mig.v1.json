{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agiledefense.example/schemas/mig/1.1",
  "title": "Mission Intent Graph (MIG) v1.1",
  "description": "Canonical mission representation produced by the LLM decomposer and validated by the deterministic constraint checker before human authorization. Extends v1.0 with contingency_ladder and conditional_branches.",
  "type": "object",
  "required": ["version", "mission_id", "created_at", "intent", "vehicles", "waypoints", "constraints", "status"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "const": "1.1"
    },
    "mission_id": {
      "type": "string",
      "pattern": "^MSN-[0-9A-F]{8}$",
      "description": "Unique mission identifier (e.g. MSN-A1B2C3D4)"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC creation timestamp (ISO 8601)"
    },
    "intent": {
      "type": "string",
      "minLength": 10,
      "description": "Original natural-language mission intent"
    },
    "vehicles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/Vehicle" }
    },
    "waypoints": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/Waypoint" }
    },
    "constraints": { "$ref": "#/definitions/Constraints" },
    "status": {
      "type": "string",
      "enum": ["planning", "validation_failed", "pending_authorization", "authorized", "dispatching", "dispatched", "failed"]
    },
    "validation_errors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "contingency_ladder": {
      "type": "array",
      "description": "Ordered list of contingency rungs executed in priority order when a trigger fires.",
      "items": { "$ref": "#/definitions/ContingencyRung" }
    },
    "conditional_branches": {
      "type": "array",
      "description": "If/then branches that reference specific vehicle IDs; evaluated by the onboard executor.",
      "items": { "$ref": "#/definitions/ConditionalBranch" }
    }
  },
  "definitions": {
    "Vehicle": {
      "type": "object",
      "required": ["id", "vehicle_type", "sitl_target", "mavlink_sysid", "waypoints"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "vehicle_type": { "type": "string", "enum": ["multirotor", "rover"] },
        "sitl_target": { "type": "string" },
        "mavlink_sysid": { "type": "integer", "minimum": 1, "maximum": 255 },
        "waypoints": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Ordered list of Waypoint IDs assigned to this vehicle"
        }
      }
    },
    "Waypoint": {
      "type": "object",
      "required": ["id", "lat", "lon", "alt_m", "role"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "alt_m": { "type": "number", "minimum": -100 },
        "role": {
          "type": "string",
          "description": "Semantic role: survey | loiter | hover | perimeter | rtl | transit | land | etc."
        },
        "timing": {
          "type": ["object", "null"],
          "description": "Optional timing constraints for this waypoint.",
          "additionalProperties": false,
          "properties": {
            "earliest_sec": { "type": "number", "description": "Earliest arrival time (seconds from mission start)" },
            "latest_sec":   { "type": "number", "description": "Latest arrival time (seconds from mission start)" },
            "dwell_sec":    { "type": "number", "description": "Minimum dwell / loiter time at this point" }
          }
        }
      }
    },
    "Constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "geofence_polygon": {
          "type": "array",
          "items": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 2,
            "maxItems": 2
          },
          "description": "List of [lat, lon] pairs forming the closed geofence boundary"
        },
        "max_alt_m": { "type": "number", "default": 120.0 },
        "min_alt_m": { "type": "number", "default": 2.0 },
        "require_rtl": { "type": "boolean", "default": true },
        "max_range_m": { "type": "number", "default": 5000.0 }
      }
    },
    "ContingencyAction": {
      "type": "object",
      "required": ["action_type"],
      "additionalProperties": false,
      "properties": {
        "action_type": {
          "type": "string",
          "description": "Action verb: rtl | land | loiter | hold | abort | goto_waypoint"
        },
        "vehicle_id": {
          "type": ["string", "null"],
          "description": "Target vehicle ID; null means apply to all vehicles"
        },
        "waypoint_id": {
          "type": ["string", "null"],
          "description": "Reference to a Waypoint ID (used with goto_waypoint)"
        },
        "parameters": {
          "type": ["object", "null"],
          "description": "Action-specific parameters"
        }
      }
    },
    "ContingencyRung": {
      "type": "object",
      "required": ["trigger", "actions"],
      "additionalProperties": false,
      "description": "A single rung of the contingency ladder: when trigger fires, execute actions in order.",
      "properties": {
        "trigger": {
          "type": "string",
          "description": "Trigger condition: link_loss | geofence_breach | low_battery | operator_abort | custom:<name>"
        },
        "priority": {
          "type": "integer",
          "description": "Lower number = higher priority when multiple triggers fire simultaneously",
          "default": 100
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/ContingencyAction" }
        }
      }
    },
    "ConditionalBranch": {
      "type": "object",
      "required": ["condition", "if_vehicle_id", "then"],
      "additionalProperties": false,
      "description": "An if/then branch evaluated at runtime; the condition references one vehicle's state.",
      "properties": {
        "condition": {
          "type": "string",
          "description": "Boolean condition expression, e.g. 'threat_detected', 'battery_pct < 20', 'waypoint_reached:WP-2'"
        },
        "if_vehicle_id": {
          "type": "string",
          "description": "The vehicle whose state is evaluated for this condition"
        },
        "then": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/ContingencyAction" },
          "description": "Actions to execute when the condition is true"
        },
        "else": {
          "type": "array",
          "items": { "$ref": "#/definitions/ContingencyAction" },
          "description": "Optional actions to execute when the condition is false"
        }
      }
    }
  }
}
